<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Node (npx, codex) comes from fnm, which only .zshrc loads; the job loads it itself.
     TARS-ORCH v0 runner: every 30 min one tick (continue / resume after PAUSED / pick next order).
     Install: tars/orch/launchd/install.sh  ·  Remove: launchctl bootout gui/$(id -u)/work.good-inventions.tars-orch -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>work.good-inventions.tars-orch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>eval "$(fnm env --shell zsh)" &amp;&amp; fnm use default &gt;/dev/null &amp;&amp; cd "$HOME/Projects/muj-web" &amp;&amp; npx tsx tars/orch/cli.ts tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Run 2 scope: copy only (vizual via variant B not yet proven live). Required: tick refuses to run without it (N3).
         All departments = copy,dev,vizual. -->
    <key>TARS_DEPARTMENTS</key>
    <string>copy</string>
    <!-- Dodatek PR 5 (P20): Notion user ID vlastníka. Bez něj se žádné GO/REJECT z panelu nepřijme (fail-closed). -->
    <key>TARS_OWNER_NOTION_USER_ID</key>
    <string>28ed872b-594c-813f-b94f-00025f08b7b6</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/tars-orch.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tars-orch.err.log</string>
</dict>
</plist>
