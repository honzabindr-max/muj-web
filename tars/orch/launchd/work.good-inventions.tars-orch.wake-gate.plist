<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Etapa 4 PR 2 (NAVRH-v6 §10.2, Q5-A): varianta s minutovou bránou wake-gate.sh. Stejný Label jako
     work.good-inventions.tars-orch.plist, takže instalace jedné varianty nahradí druhou (nikdy neběží obě).
     Každou minutu (StartCalendarInterval; po probuzení Macu doběhne jednou) spustí bránu; ta rozhodne, zda pustit
     plný tick (next-wake, re-entry, pojistka 30 min). Tick = stejný příkaz jako ve variantě se StartInterval.
     Instalace (jen s kartou a GO vlastníka): tars/orch/launchd/install.sh wake-gate
     Návrat (backward): tars/orch/launchd/install.sh   ·   Odebrání: launchctl bootout gui/$(id -u)/work.good-inventions.tars-orch -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>work.good-inventions.tars-orch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec /bin/sh "$HOME/Projects/muj-web/tars/orch/launchd/wake-gate.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Run 2 scope: copy only (beze změny proti StartInterval variantě). -->
    <key>TARS_DEPARTMENTS</key>
    <string>copy</string>
    <!-- Plný tick (Node z fnm, které načítá jen .zshrc; úloha si ho načte sama). Brána mu předá TARS_GATE_START. -->
    <key>TARS_GATE_TICK</key>
    <string>exec /bin/zsh -lc 'eval "$(fnm env --shell zsh)" &amp;&amp; fnm use default &gt;/dev/null &amp;&amp; cd "$HOME/Projects/muj-web" &amp;&amp; npx tsx tars/orch/cli.ts tick'</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>1</integer></dict>
