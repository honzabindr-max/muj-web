{
  "status": "PENDING_LOCAL_EXPORT",
  "why": "Uživatelský stav existuje jen v produkční Neon DB (SAM_BYT_DATABASE_URL). Cloud session auditu k ní nemá credentials ani síťový přístup. Hodnoty obsahují osobní poznámky Sama/Honzíka → plný export se do gitu NEcommituje (pravidlo: osobní data nikdy v repu).",
  "how_to_fill": "npx tsx sam-byt/audit/export-state-readonly.ts production  →  CURRENT_SAM_BYT_USER_STATE.local.json (gitignored). Agregované počty (bez poznámek) vlož do SAM_BYT_AUDIT_REPORT.md.",
  "persistence": {
    "storage": "Neon Postgres, tabulka sam_byt_user_listing_state (PK user_id+listing_id) + sam_byt_decision_events (append-only historie)",
    "client_storage": "žádné (localStorage/sessionStorage se v /sam-byt nepoužívá)",
    "key": "listing_id = internal_id z CURRENT_SAM_BYT_CATALOG.json"
  },
  "schema": {
    "per_user_fields": {
      "favorite": "boolean, default false",
      "decision": "text: unreviewed|favorite|maybe|want_viewing|reject, default unreviewed (want_viewing = Samovo „chci na prohlídku“)",
      "notes": "text ≤2000, default ",
      "rating_price": "1–5|null",
      "rating_pet": "1–5|null",
      "rating_location": "1–5|null",
      "rating_balcony": "1–5|null",
      "rating_furnishing": "1–5|null",
      "version": "int (optimistic concurrency)",
      "updated_at": "timestamptz"
    },
    "constraints": [
      "listing_id CHECK ^sam-(0[1-9]|1[01])$",
      "NOT (favorite AND decision=reject)",
      "user_id FK → sam_byt_users ON DELETE CASCADE"
    ],
    "users": "sam_byt_users: username ∈ {sam, honzik}; user_id = uuid",
    "history": "sam_byt_decision_events: id, user_id, listing_id, field, old_value, new_value, created_at — zapisuje se v téže transakci jako změna stavu",
    "absent_row_means": "Řádek chybí = uživatel byt nikdy neupravil = výchozí stav (unreviewed, bez poznámky). Není to ztráta dat."
  },
  "visibility": {
    "sam": "vidí jen svůj stav",
    "honzik": "vidí svůj + Samův stav a posledních 100 událostí historie (/api/sam-byt/events)"
  },
